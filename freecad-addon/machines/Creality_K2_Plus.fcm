{
  "name": "Creality K2 Plus",
  "manufacturer": "Creality",
  "description": "FDM 3D printer — 350×350×350 mm, CoreXY, dual-gear direct drive, Klipper firmware with Moonraker + Fluidd, heated chamber, CFS multi-color",
  "configuration_units": "metric",
  "version": 1,
  "linear_axes": {
    "X": {
      "name": "X",
      "direction_vector": [1, 0, 0],
      "min_limit": 0,
      "max_limit": 350,
      "max_velocity": 36000,
      "sequence": 0,
      "role": "table_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    },
    "Y": {
      "name": "Y",
      "direction_vector": [0, 1, 0],
      "min_limit": 0,
      "max_limit": 350,
      "max_velocity": 36000,
      "sequence": 1,
      "role": "table_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    },
    "Z": {
      "name": "Z",
      "direction_vector": [0, 0, 1],
      "min_limit": 0,
      "max_limit": 350,
      "max_velocity": 18000,
      "sequence": 2,
      "role": "head_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    }
  },
  "rotary_axes": {},
  "toolheads": [],
  "postprocessor_file_name": "klipper_moonraker",
  "output": {
    "output_units": "metric",
    "line_numbers": false,
    "show_editor": false,
    "output_path_labels": false,
    "output_tool_change": false
  },
  "worktrack_extensions": {
    "kind": "fdm",
    "max_nozzle_temp_c": 350,
    "max_bed_temp_c": 120,
    "chamber_temp_c": 60,
    "max_speed_mm_s": 600,
    "max_accel_mm_s2": 30000,
    "nozzle_diameter_mm": 0.4,
    "filament_diameter_mm": 1.75,
    "input_shaping_presets": ["ZV", "MZV", "EI", "2HUMP_EI", "3HUMP_EI"],
    "rfid_filament_support": true,
    "cfs_multi_color_enabled": true,
    "power_loss_recovery": true,
    "auto_leveling": true,
    "moonraker_default_url": "http://192.168.1.100:7125",
    "dialect": "generic_mm"
  }
}
