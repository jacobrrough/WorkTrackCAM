{
  "name": "Makera Carvera (4th Axis HD)",
  "manufacturer": "Makera",
  "description": "Desktop 4-axis CNC with harmonic-drive rotary module — 240×92 mm rotary work area, continuous A-axis, manual tool change (rotary occupies ATC bay)",
  "configuration_units": "metric",
  "version": 1,
  "linear_axes": {
    "X": {
      "name": "X",
      "direction_vector": [1, 0, 0],
      "min_limit": 0,
      "max_limit": 240,
      "max_velocity": 2400,
      "sequence": 0,
      "role": "table_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    },
    "Y": {
      "name": "Y",
      "direction_vector": [0, 1, 0],
      "min_limit": 0,
      "max_limit": 92,
      "max_velocity": 2400,
      "sequence": 1,
      "role": "table_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    },
    "Z": {
      "name": "Z",
      "direction_vector": [0, 0, 1],
      "min_limit": 0,
      "max_limit": 46,
      "max_velocity": 2400,
      "sequence": 2,
      "role": "head_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    }
  },
  "rotary_axes": {
    "A": {
      "name": "A",
      "rotation_vector": [1, 0, 0],
      "min_limit": -99999,
      "max_limit": 99999,
      "max_velocity": 2160,
      "sequence": 3,
      "prefer_positive": true,
      "role": "table_rotary",
      "parent": null,
      "joint_origin": [0, 0, 0],
      "solution_preference": "shortest",
      "allow_flip": true
    }
  },
  "primary_rotary_axis": "A",
  "toolheads": [
    {
      "name": "Spindle",
      "toolhead_type": "rotary",
      "max_power_kw": 0.2,
      "max_rpm": 15000,
      "min_rpm": 6000,
      "tool_change": "manual",
      "coolant_flood": false,
      "coolant_mist": false,
      "coolant_delay": 0.0,
      "toolhead_wait": 2.0
    }
  ],
  "postprocessor_file_name": "makera_carvera_4axis",
  "output": {
    "output_units": "metric",
    "line_numbers": false,
    "show_editor": true,
    "output_path_labels": true,
    "output_tool_change": false,
    "preamble": "G90 G21 G17",
    "postamble": "M5\nA0\nG4 P2\nG0 Z46\nM2"
  },
  "worktrack_extensions": {
    "kind": "cnc",
    "axis_count": 4,
    "a_axis_orientation": "x",
    "max_rotary_rpm": 6,
    "rotary_chuck_outer_radius_mm": 46,
    "dialect": "grbl_4axis"
  }
}
