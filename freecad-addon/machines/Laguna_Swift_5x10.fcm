{
  "name": "Laguna Swift 5×10",
  "manufacturer": "Laguna",
  "description": "Large-format 3-axis CNC router — 60×120 in work area, RichAuto A-series controller, helical rack & pinion X/Y, ball screw Z, 3 HP liquid-cooled spindle, 6-zone vacuum table",
  "configuration_units": "metric",
  "version": 1,
  "linear_axes": {
    "X": {
      "name": "X",
      "direction_vector": [1, 0, 0],
      "min_limit": 0,
      "max_limit": 1524,
      "max_velocity": 12000,
      "sequence": 0,
      "role": "table_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    },
    "Y": {
      "name": "Y",
      "direction_vector": [0, 1, 0],
      "min_limit": 0,
      "max_limit": 3048,
      "max_velocity": 12000,
      "sequence": 1,
      "role": "table_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    },
    "Z": {
      "name": "Z",
      "direction_vector": [0, 0, 1],
      "min_limit": 0,
      "max_limit": 203,
      "max_velocity": 5000,
      "sequence": 2,
      "role": "head_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    }
  },
  "rotary_axes": {},
  "toolheads": [
    {
      "name": "Spindle",
      "toolhead_type": "rotary",
      "max_power_kw": 2.24,
      "max_rpm": 24000,
      "min_rpm": 6000,
      "tool_change": "manual",
      "coolant_flood": false,
      "coolant_mist": false,
      "coolant_delay": 0.0,
      "toolhead_wait": 3.0
    }
  ],
  "postprocessor_file_name": "richauto_a_series",
  "output": {
    "output_units": "metric",
    "line_numbers": false,
    "show_editor": true,
    "output_path_labels": true,
    "output_tool_change": true,
    "preamble": "G90 G21 G17\nG0 Z25.0",
    "postamble": "M5\nG0 Z25.0\nM9\nM30"
  },
  "worktrack_extensions": {
    "kind": "cnc",
    "vacuum_zone_count": 6,
    "safe_retract_z_mm": 25,
    "dust_collection": true,
    "spindle_variant_hp": 3,
    "dialect": "mach3"
  }
}
