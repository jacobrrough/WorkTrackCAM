{
  "name": "Makera Carvera (3-Axis)",
  "manufacturer": "Makera",
  "description": "Desktop 3-axis CNC with automatic tool changer — 360×240×140 mm, 200W spindle 13000-15000 RPM, ATC 6 slots + wireless probe, auto leveling",
  "configuration_units": "metric",
  "version": 1,
  "linear_axes": {
    "X": {
      "name": "X",
      "direction_vector": [1, 0, 0],
      "min_limit": 0,
      "max_limit": 360,
      "max_velocity": 2400,
      "sequence": 0,
      "role": "table_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    },
    "Y": {
      "name": "Y",
      "direction_vector": [0, 1, 0],
      "min_limit": 0,
      "max_limit": 240,
      "max_velocity": 2400,
      "sequence": 1,
      "role": "table_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    },
    "Z": {
      "name": "Z",
      "direction_vector": [0, 0, 1],
      "min_limit": 0,
      "max_limit": 140,
      "max_velocity": 2400,
      "sequence": 2,
      "role": "head_linear",
      "parent": null,
      "joint_origin": [0, 0, 0]
    }
  },
  "rotary_axes": {},
  "toolheads": [
    {
      "name": "Spindle",
      "toolhead_type": "rotary",
      "max_power_kw": 0.2,
      "max_rpm": 15000,
      "min_rpm": 6000,
      "tool_change": "atc",
      "coolant_flood": false,
      "coolant_mist": false,
      "coolant_delay": 0.0,
      "toolhead_wait": 2.0
    }
  ],
  "postprocessor_file_name": "makera_carvera",
  "output": {
    "output_units": "metric",
    "line_numbers": false,
    "show_editor": true,
    "output_path_labels": true,
    "output_tool_change": true,
    "preamble": "G90 G21 G17",
    "postamble": "M5\nG4 P2\nG0 Z50\nM2"
  },
  "worktrack_extensions": {
    "kind": "cnc",
    "atc_slot_count": 6,
    "atc_probe_slot": 0,
    "auto_leveling": true,
    "dust_collection": true,
    "dialect": "smoothieware"
  }
}
