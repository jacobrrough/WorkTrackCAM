{
  "name": "worktrack-3d",
  "version": "0.1.0",
  "private": true,
  "description": "WorkTrack3D — CAD-to-CAM: parametric modeling, CNC toolpaths, FDM slicing, and machine management",
  "author": "WorkTrack",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "pretest": "node scripts/check-no-dump-stubs.cjs",
    "test": "vitest run",
    "test:dom": "vitest run -c vitest.dom.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:python": "node scripts/run-python-tests.cjs",
    "typecheck": "tsc --noEmit",
    "check:no-dump-stubs": "node scripts/check-no-dump-stubs.cjs",
    "verify:release-gate": "node scripts/verify-release-gate.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "clipper-lib": "^6.4.2",
    "electron-updater": "^6.8.3",
    "handlebars": "^4.7.8",
    "json5": "^2.2.3",
    "monaco-editor": "^0.55.1",
    "opentype.js": "^2.0.0",
    "smol-toml": "^1.6.1",
    "three": "^0.183.2",
    "yaml": "^2.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "cross-env": "^7.0.3",
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "happy-dom": "^20.10.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.4.2",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "dompurify": "^3.4.8"
  },
  "build": {
    "productName": "WorkTrack3D",
    "appId": "com.worktrack.3d",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!resources/orca-slicer/win32-x64/**",
      "!resources/orca-slicer/darwin-arm64/**",
      "!resources/orca-slicer/linux-x64/**"
    ],
    "extraResources": [
      {
        "from": "engines",
        "to": "engines",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/orca-slicer/win32-x64",
        "to": "resources/orca-slicer/win32-x64",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/orca-slicer/profiles",
        "to": "resources/orca-slicer/profiles",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/fonts",
        "to": "resources/fonts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WorkTrack3D"
    },
    "fileAssociations": [
      {
        "ext": "wt3d",
        "name": "WorkTrack3D Project",
        "description": "WorkTrack3D project file",
        "role": "Editor"
      },
      {
        "ext": "wtcam",
        "name": "WorkTrack3D Project (legacy)",
        "description": "Legacy WorkTrackCAM project file — opens in WorkTrack3D",
        "role": "Editor"
      }
    ]
  }
}
