# Temp files used by the orchestration agents for commit messages and log appends
COMMIT_MSG.txt
append_log.py
fix_log.py

# Dependencies
node_modules/

# Build output
out/
dist/

# Test coverage
coverage/

# Python cache
__pycache__/
*.pyc
*.pyo
engines/**/__pycache__/
engines/**/*.pyc
.venv/
*.egg-info/

# Editor directories
.vscode/
.idea/

# OS-generated files
.DS_Store
Thumbs.db

# Build artifacts
build/

# Pytest cache
.pytest_cache/

# Claude Code — ignore everything except the shared workflow files.
.claude/*
!.claude/improvement-log.md
!.claude/commands/
.claude/commands/*
!.claude/commands/*.md

# OrcaSlicer bundled binaries — produced by scripts/bundle-orca-slicer.ps1
# and shipped via electron-builder `extraResources`. The portable build is
# ~150 MB extracted and must NOT live in git. Profiles (resources/orca-slicer/profiles/)
# ARE source-tracked.
resources/orca-slicer/win32-x64/
resources/orca-slicer/darwin-arm64/
resources/orca-slicer/linux-x64/

# Temp / log files
*.log
*.tmp
npm-debug.log*
engines/cam/_tmp_*.json
cam/_tmp_*.json
# Throwaway render / debug scratch scripts (sandbox can't delete, so ignore).
_render-*.cjs
_render-*.mjs
_scratch-*.cjs
_scratch-*.mjs
